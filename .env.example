# UCDFS webapp environment template.
#
# There is one of these per tier, and which file you point at IS which database
# you are talking to. Nothing else distinguishes them:
#
#   .env           production. The real team's accounts, attendance and photos.
#                  Supabase project fs-attendance. UCDFS_ENV=prod.
#   .env.nonprod   dev, stage and the test suite. Supabase project
#                  ucdfs-nonprod, same schema, nobody real in it.
#                  UCDFS_ENV=nonprod.
#
# Both are gitignored (.gitignore ignores .env.*); this template is not.
#
#   cp .env.example .env.nonprod
#
# Keys come from the Supabase dashboard → Project Settings → API Keys.

# Which tier this file describes: prod | nonprod.
#
# Not decoration. deploy.sh refuses to start dev or stage from a file labelled
# prod, and the test suite refuses to run against one at all. The suites sign
# up accounts, write attendance and assert that deletion works, which against
# production is real people's history. Label the file honestly or the guards
# protect nothing.
UCDFS_ENV=nonprod

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# anon / publishable key. Safe to ship to browsers ONLY because RLS is enabled
# on every table with no permissive policies. Used for the GoTrue apikey header.
SUPABASE_KEY=

# service_role key. Bypasses RLS: this is what the backend uses for all data
# access. Treat it like a database password: server-side only, never in a
# browser, never committed.
SUPABASE_SERVICE_KEY=

# Who may create an account. Comma-separated. Empty = allow any domain.
ALLOWED_EMAIL_DOMAINS=ucdconnect.ie,ucd.ie

# 1 = session cookies marked Secure (HTTPS only). Production is 1. dev and
# stage are 0 because they are reached over plain http on the LAN, and a Secure
# cookie over http is a cookie the browser silently drops, which presents as
# "signing in does nothing".
COOKIE_SECURE=0

# Where uploaded files (profile photos) are written inside the container.
# deploy.sh mounts a per-tier host directory over this, so the files survive a
# rebuild and staging never gets a copy of real people's faces.
UPLOAD_DIR=/app/uploads
