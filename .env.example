# UCDFS webapp — environment template.
# Copy to .env and fill in real values. .env is gitignored; this file is not.
#
#   cp .env.example .env
#
# Keys come from the Supabase dashboard → Project Settings → API Keys.

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# anon / publishable key. Safe to ship to browsers ONLY because RLS is enabled
# on every table with no permissive policies. Used for the GoTrue apikey header.
SUPABASE_KEY=

# service_role key. Bypasses RLS — this is what the backend uses for all data
# access. Treat it like a database password: server-side only, never in a
# browser, never committed.
SUPABASE_SERVICE_KEY=

# Legacy shared password for Competition Hub admin actions. Accepted as a
# fallback alongside the `admin` role. Leave blank once roles are assigned.
COMP_ADMIN_PASSWORD=

# Who may create an account. Comma-separated. Empty = allow any domain.
ALLOWED_EMAIL_DOMAINS=ucdconnect.ie,ucd.ie

# 1 = session cookies marked Secure (HTTPS only). Use 0 only for local http.
COOKIE_SECURE=1

# Where uploaded files (profile photos) are written inside the container.
# docker-compose mounts ./data/uploads over this, so the files survive a rebuild.
# Change both together or photos vanish on the next deploy.
UPLOAD_DIR=/app/uploads
